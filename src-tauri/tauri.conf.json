{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadar",
  "version": "0.1.0",
  "identifier": "com.msantic.kadar",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kadar",
        "width": 1100,
        "height": 720,
        "minWidth": 520,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#161618"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: viewer-file: http://viewer-file.localhost; media-src 'self' viewer-file: http://viewer-file.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: viewer-file: http://viewer-file.localhost; media-src 'self' viewer-file: http://viewer-file.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "bin/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "Developer ID Application: Prelako d.o.o. (FC2M54RD3H)"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "heic",
          "heif",
          "webp",
          "gif",
          "tif",
          "tiff",
          "bmp",
          "avif",
          "dng",
          "cr2",
          "cr3",
          "nef",
          "arw",
          "raf",
          "orf",
          "rw2",
          "pef",
          "srw",
          "psd"
        ],
        "contentTypes": [
          "public.jpeg",
          "public.png",
          "public.heic",
          "public.heif",
          "org.webmproject.webp",
          "com.compuserve.gif",
          "public.tiff",
          "com.microsoft.bmp",
          "public.avif",
          "public.camera-raw-image",
          "com.adobe.photoshop-image"
        ],
        "name": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp4",
          "mov",
          "m4v",
          "webm"
        ],
        "contentTypes": [
          "public.mpeg-4",
          "com.apple.quicktime-movie",
          "com.apple.m4v-video",
          "org.webmproject.webm"
        ],
        "name": "Video",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [],
        "contentTypes": [
          "public.folder"
        ],
        "name": "Folder",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
