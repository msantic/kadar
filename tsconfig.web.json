{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/renderer/**/*.ts", "app/**/*.ts"],
  "exclude": ["app/vite.config.ts", "app/dist", "app/src-tauri"]
}
